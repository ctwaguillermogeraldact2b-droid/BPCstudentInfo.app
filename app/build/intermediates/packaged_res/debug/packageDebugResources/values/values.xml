    <style name="Card.BPC" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Text" parent="android:Widget.TextView"/>
    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>
    <style name="Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Meta">
        <item name="android:textSize">@dimen/text_meta</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>
    <style name="Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Theme.BPC" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/bpc_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/bpc_green_tint</item>
        <item name="colorOnPrimaryContainer">@color/bpc_green_deep</item>
        <item name="colorSecondary">@color/bpc_gold_deep</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorOutline">@color/hairline</item>
        <item name="android:statusBarColor">@color/bpc_green_deep</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="materialButtonStyle">@style/Widget.BPC.Button</item>
        <item name="textInputStyle">@style/Widget.BPC.TextField</item>
    </style>
    <style name="Widget.BPC.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">10dp</item>
    </style>
    <style name="Widget.BPC.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>
