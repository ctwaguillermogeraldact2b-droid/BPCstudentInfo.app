<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="40dp"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/gutter">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Class schedule"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvScheduleSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/bpc_gold"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dayTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="@dimen/gutter"
        android:paddingEnd="@dimen/gutter" />

    <TextView
        android:id="@+id/tvDayTotal"
        style="@style/Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="@dimen/gutter_tight"
        android:layout_marginEnd="@dimen/gutter" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSchedule"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="@dimen/gutter_tight"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/gutter" />

    <TextView
        android:id="@+id/tvScheduleEmpty"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="@dimen/gutter_loose"
        android:text="Nothing scheduled for this day."
        android:textColor="@color/ink_muted"
        android:visibility="gone" />
</LinearLayout>
