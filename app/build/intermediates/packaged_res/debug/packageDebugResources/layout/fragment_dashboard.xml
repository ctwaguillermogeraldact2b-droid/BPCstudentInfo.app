<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/gutter_loose">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="40dp"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="52dp">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bpc_gold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/white"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvTerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <include
            android:id="@+id/idCard"
            layout="@layout/view_id_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="@dimen/gutter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            android:orientation="horizontal"
            android:weightSum="3">

            <include
                android:id="@+id/statUnits"
                layout="@layout/view_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/statSubjects"
                layout="@layout/view_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gutter_tight"
                android:layout_weight="1" />

            <include
                android:id="@+id/statAverage"
                layout="@layout/view_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gutter_tight"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="@dimen/gutter_loose"
            android:text="Up next today" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNextClasses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter_tight"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter" />

        <TextView
            android:id="@+id/tvNoClasses"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="@dimen/gutter_tight"
            android:layout_marginEnd="@dimen/gutter"
            android:text="No classes scheduled. Use the free day to read ahead."
            android:textColor="@color/ink_muted"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMissedTitle"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="@dimen/gutter_loose"
            android:text="Missed / Pending Activities" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMissedActivities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter_tight"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="@dimen/gutter_loose"
            android:text="From the college" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAnnouncements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter_tight"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
