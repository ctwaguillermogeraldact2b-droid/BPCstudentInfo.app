<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Official Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="Republic of the Philippines"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="BULACAN POLYTECHNIC COLLEGE"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

            <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="OFFICE OF THE REGISTRAR"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="INDIVIDUAL REPORT OF GRADES"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Student Meta Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvReportStudentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student Name: —"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportStudentNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Student No: —"
                android:textColor="@color/ink"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvReportProgramSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Program &amp; Section: —"
                android:textColor="@color/ink"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Grades Table Container -->
        <LinearLayout
            android:id="@+id/containerGradesTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvReportGwa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="General Weighted Average (GWA): —"
            android:textColor="@color/bpc_green_deep"
            android:textSize="12sp" />

        <!-- Grading System Legend & Signatures -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Legend -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="0dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ink"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="GRADING SYSTEM"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1.00–1.25: Excellent | 1.50–1.75: V. Good\n2.00–2.50: Good | 2.75–3.00: Passing\n4.00: Conditional | 5.00: Failure\nD: Dropped | INC: Incomplete | IP: In Progress"
                    android:textColor="@color/ink"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Signatures -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prepared and certified by:"
                    android:textColor="@color/ink"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="28dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ink" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Registrar / Records Officer"
                    android:textColor="@color/ink"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Approved by:"
                    android:textColor="@color/ink"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ink" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="College Dean / President"
                    android:textColor="@color/ink"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Footer Distribution -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="DISTRIBUTION: Copy 1 - Student Copy | Copy 2 - Registrar File | Copy 3 - Department Archive"
            android:textColor="@color/ink"
            android:textSize="10sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
